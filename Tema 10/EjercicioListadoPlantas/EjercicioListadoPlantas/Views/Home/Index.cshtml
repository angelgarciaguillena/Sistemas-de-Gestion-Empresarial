@{
    ViewBag.Title = "Inicio";
}

<div style="text-align: center; margin-top: 50px;">
    <h1>Bienvenido</h1>
    <h3>Sistema de Gestión de Plantas Medicinales</h3>
    <br />
    @Html.ActionLink("Ir a Gestión de Plantas", "Index", "Planta", null, new { @class = "btn btn-primary btn-lg" })
</div>

// UI/Views/Plantas/Index.cshtml
@model App.Domain.DTOs.ListadoCategoriasConListadoPlantas

@{
    ViewBag.Title = "Gestión de Plantas";
}

<h2>Gestión de Plantas Medicinales</h2>

<div class="row" style="margin-top: 20px;">
    <div class="col-md-6">
        @using (Html.BeginForm("Index", "Planta", FormMethod.Post))
        {
            <div class="form-group">
                <label for="idCategoria">Seleccione una Categoría:</label>
                <select name="idCategoria" id="idCategoria" class="form-control">
                    <option value="0">-- Seleccione una categoría --</option>
                    @foreach (var categoria in Model.ListadoCategorias)
                    {
                        <option value="@categoria.Id">@categoria.Nombre</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Mostrar Plantas</button>
        }
    </div>
</div>

@if (Model.ListadoPlantas != null && Model.ListadoPlantas.Count > 0)
{
    <div class="row" style="margin-top: 40px;">
        <div class="col-md-12">
            <h3>Listado de Plantas</h3>
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Nombre de la Planta</th>
                        <th>Precio Actual</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var planta in Model.ListadoPlantas)
                    {
                        <tr>
                            <td>@planta.Nombre</td>
                            <td>@planta.Precio.ToString("C2")</td>
                            <td>
                                @Html.ActionLink("Asignar precio", "Update", new { idPlanta = planta.Id }, new { @class = "btn btn-sm btn-info" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (Model.ListadoPlantas != null && Model.ListadoPlantas.Count == 0)
{
    <div class="alert alert-info" style="margin-top: 20px;">
        No hay plantas disponibles para esta categoría.
    </div>
}