@model Domain.Entities.Departamento

<h2>Editar Departamento</h2>

<form asp-action="EditarDepartamento" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <button class="btn btn-primary mt-3" type="submit">Guardar cambios</button>
    <a asp-action="IndexDepartamento" class="btn btn-secondary mt-3">Volver</a>
</form>
