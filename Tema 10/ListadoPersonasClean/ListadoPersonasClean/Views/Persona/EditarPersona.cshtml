@model Domain.DTOS.PersonaConListadoDepartamento

<h2>Editar Persona</h2>

<form asp-action="EditarPersona" enctype="multipart/form-data" method="post">
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <!-- Campo hidden del Id -->
    <input type="hidden" asp-for="Persona.Id" />

    <div class="form-group">
        <label>Nombre</label>
        <input asp-for="Persona.Nombre" class="form-control" />
        <span asp-validation-for="Persona.Nombre" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Apellidos</label>
        <input asp-for="Persona.Apellidos" class="form-control" />
        <span asp-validation-for="Persona.Apellidos" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Telefono</label>
        <input asp-for="Persona.Telefono" class="form-control" />
        <span asp-validation-for="Persona.Telefono" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Dirección</label>
        <input asp-for="Persona.Direccion" class="form-control" />
        <span asp-validation-for="Persona.Direccion" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Fecha Nacimiento</label>
        <input asp-for="Persona.FechaNacimiento" type="date" class="form-control" />
        <span asp-validation-for="Persona.FechaNacimiento" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Departamento</label>
        <select asp-for="Persona.IdDepartamento"
                class="form-control"
                asp-items="@(new SelectList(Model.ListadoDepartamentos, "Id", "Nombre", Model.Persona.IdDepartamento))">
        </select>
        <span asp-validation-for="Persona.IdDepartamento" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Foto</label>
        <input type="file" name="FotoFile" class="form-control" />
        <span asp-validation-for="Persona.Foto" class="text-danger"></span>
    </div>

    <button class="btn btn-primary mt-3" type="submit">Guardar cambios</button>
    <a asp-action="IndexPersona" class="btn btn-secondary mt-3">Volver</a>
</form>
