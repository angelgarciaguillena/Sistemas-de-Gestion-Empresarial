@model IEnumerable<Domain.Entities.Persona>

@{
    ViewData["Title"] = "Listado de Personas";
}

<h1>@ViewData["Title"]</h1>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.id)</th>
            <th>@Html.DisplayNameFor(model => model.nombre)</th>
            <th>@Html.DisplayNameFor(model => model.apellido)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var persona in Model)
        {
            <tr>
                <td>@Html.DisplayFor(m => persona.id)</td>
                <td>@Html.DisplayFor(m => persona.nombre)</td>
                <td>@Html.DisplayFor(m => persona.apellido)</td>
            </tr>
        }
    </tbody>
</table>
