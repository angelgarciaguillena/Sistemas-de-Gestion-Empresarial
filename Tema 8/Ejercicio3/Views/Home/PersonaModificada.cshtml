@model Ejercicio3.Models.clsPersona
@{
    ViewData["Title"] = "Persona Modificada";
}

<h2>Persona Modificada</h2>

<div>
    <label for="Id">ID</label>
    <p>@Model.id</p>
</div>
<div>
    <label for="Nombre">Nombre</label>
    <p>@Model.nombre</p>
</div>
<div>
    <label for="Apellido">Apellido</label>
    <p>@Model.apellido</p>
</div>

@Html.ActionLink("Editar de nuevo", "Index", "Home")